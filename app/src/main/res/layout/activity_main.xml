<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to FitTrack!"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnGoToWater"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Water Tracker &amp; Reminders"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnGoToSettings"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Settings"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnGoToCalories"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Calorie Tracker"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnGoToProfile"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="User Profile &amp; BMI"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnGoToWorkouts"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Start a Workout"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:backgroundTint="#D32F2F" />

</LinearLayout>